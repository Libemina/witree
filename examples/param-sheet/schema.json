{
  "$schema": "../../meta/schema.v0.1.json",
  "specVersion": "0.1",
  "schemaVersion": 1,
  "id": "networkParams",
  "title": "ネットワーク機器パラメータシート",
  "enums": {
    "role": [
      { "value": "core", "label": "コア" },
      { "value": "distribution", "label": "ディストリビューション" },
      { "value": "access", "label": "アクセス" }
    ]
  },
  "root": {
    "children": {
      "Site": { "cardinality": "many" }
    }
  },
  "types": {
    "Site": {
      "label": "拠点",
      "titleTemplate": "{code} {name}",
      "fields": {
        "code": { "type": "string", "label": "拠点コード", "required": true, "pattern": "^[A-Z]{3}[0-9]{2}$" },
        "name": { "type": "string", "label": "拠点名", "required": true },
        "domain": { "type": "string", "label": "ドメイン", "format": "fqdn" },
        "mgmtSubnet": { "type": "string", "label": "管理セグメント", "format": "cidr" },
        "ntp": { "type": "string", "label": "NTPサーバー（既定）", "format": "host" },
        "dns": { "type": "string", "label": "DNSサーバー（既定）", "format": "host" },
        "syslog": { "type": "string", "label": "Syslogサーバー（既定）", "format": "host" },
        "deviceCount": {
          "type": "number", "label": "機器数", "integer": true,
          "rollup": { "sourceType": "Device", "fn": "count" }
        }
      },
      "children": {
        "Device": { "cardinality": "many" }
      },
      "unique": [
        { "fields": ["code"], "scope": "workbook", "message": "拠点コードが重複しています" }
      ]
    },

    "Device": {
      "label": "機器",
      "titleTemplate": "{hostname}",
      "fields": {
        "hostname": { "type": "string", "label": "ホスト名", "required": true, "pattern": "^[a-z][a-z0-9-]{0,62}$" },
        "role": { "type": "enum", "label": "役割", "required": true, "enumRef": "role" },
        "model": {
          "type": "enum", "label": "機種",
          "values": [
            { "value": "c9300-48p", "label": "C9300-48P" },
            { "value": "c9500-24y4c", "label": "C9500-24Y4C" }
          ]
        },
        "mgmtIp": { "type": "string", "label": "管理IP", "required": true, "format": "ipv4" },
        "fqdn": { "type": "string", "label": "FQDN", "formula": "hostname & \".\" & parent.domain" },
        "interfaceCount": {
          "type": "number", "label": "IF数", "integer": true,
          "rollup": { "sourceType": "Interface", "fn": "count" }
        },
        "vlanTotal": {
          "type": "number", "label": "VLAN設定数（全IF）", "integer": true,
          "rollup": { "sourceType": "Vlan", "fn": "count", "depth": "descendants" }
        },
        "notes": { "type": "doc", "label": "備考" }
      },
      "children": {
        "System": { "cardinality": "one", "required": true },
        "Interface": { "cardinality": "many" }
      },
      "unique": [
        { "fields": ["hostname"], "scope": "workbook", "message": "ホスト名が重複しています" },
        { "fields": ["mgmtIp"], "scope": "workbook", "message": "管理IPが重複しています" }
      ],
      "checks": [
        {
          "id": "mgmtInSubnet",
          "expr": "CIDR_CONTAINS(parent.mgmtSubnet, mgmtIp)",
          "severity": "warning",
          "message": "管理IPが拠点の管理セグメント外です"
        }
      ]
    },

    "System": {
      "label": "基本設定",
      "fields": {
        "ntp": { "type": "string", "label": "NTPサーバー", "format": "host", "inherit": { "fromType": "Site" } },
        "dns": { "type": "string", "label": "DNSサーバー", "format": "host", "inherit": { "fromType": "Site" } },
        "syslog": { "type": "string", "label": "Syslogサーバー", "format": "host", "inherit": { "fromType": "Site" } },
        "timezone": {
          "type": "enum", "label": "タイムゾーン", "required": true, "default": "Asia/Tokyo",
          "values": [ { "value": "Asia/Tokyo" }, { "value": "UTC" } ]
        }
      }
    },

    "Interface": {
      "label": "インターフェース",
      "titleTemplate": "{port}",
      "fields": {
        "port": { "type": "string", "label": "ポート", "required": true, "pattern": "^(Gi|Te|Twe)[0-9]+(/[0-9]+){1,2}$" },
        "description": { "type": "string", "label": "説明" },
        "mode": {
          "type": "enum", "label": "モード", "required": true, "default": "access",
          "values": [
            { "value": "access", "label": "アクセス" },
            { "value": "trunk", "label": "トランク" }
          ]
        },
        "speed": {
          "type": "enum", "label": "速度",
          "values": [
            { "value": "1g", "label": "1G" },
            { "value": "10g", "label": "10G" },
            { "value": "25g", "label": "25G" }
          ]
        },
        "enabled": { "type": "boolean", "label": "有効", "default": true },
        "uplink": { "type": "ref", "label": "対向IF", "target": ["Interface"], "onDelete": "clear" },
        "vlanCount": {
          "type": "number", "label": "VLAN数", "integer": true,
          "rollup": { "sourceType": "Vlan", "fn": "count" }
        }
      },
      "children": {
        "Vlan": { "cardinality": "many" }
      },
      "unique": [
        { "fields": ["port"], "scope": "parent", "message": "同じ機器内でポートが重複しています" }
      ],
      "checks": [
        {
          "id": "accessSingleVlan",
          "expr": "IF(mode = \"access\", vlanCount <= 1, TRUE)",
          "message": "アクセスポートに複数のVLANが設定されています"
        }
      ]
    },

    "Vlan": {
      "label": "VLAN",
      "titleTemplate": "{vlanId} {name}",
      "fields": {
        "vlanId": { "type": "number", "label": "VLAN ID", "required": true, "integer": true, "min": 1, "max": 4094 },
        "name": { "type": "string", "label": "VLAN名", "maxLength": 32 }
      },
      "unique": [
        { "fields": ["vlanId"], "scope": "parent", "message": "同じIF内でVLAN IDが重複しています" }
      ]
    }
  }
}
